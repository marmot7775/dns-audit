# TEMPLATE. DEPLOY_USER is a placeholder for the account the service runs
# as: replace it on every line below before installing this file as
# /etc/systemd/system/dns-auditor.service. The real value lives in the
# untracked deploy.local.md (see CLAUDE.md, "Deploy").

[Unit]
Description=DNS Security Auditor - FastAPI (Full)
After=network.target

[Service]
Type=simple
User=DEPLOY_USER
WorkingDirectory=/home/DEPLOY_USER/dns-security-auditor
Environment="PATH=/home/DEPLOY_USER/.venv/bin"
# SINGLE WORKER BY DESIGN. Do not add --workers. Do not set WEB_CONCURRENCY.
# server.py keeps its coordination state in module-level globals, private to
# one process: _rate_limits, _active_audits, _inflight, _cache and
# _health_cache. The reasoning is in CLAUDE.md, "Single worker by design".
#
# --host 127.0.0.1 is also deliberate: nginx terminates TLS in front of this
# and proxies to loopback, so the app must never accept connections directly.
# --proxy-headers is deliberately absent; see _get_client_ip in server.py.
ExecStart=/home/DEPLOY_USER/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
LimitNOFILE=65535

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/DEPLOY_USER/dns-security-auditor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target

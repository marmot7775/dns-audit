# TEMPLATE. DEPLOY_USER is a placeholder for the account the service runs
# as: replace it on every line below before installing this file as
# /etc/systemd/system/dns-auditor.service. The real value lives in the
# untracked deploy.local.md (see CLAUDE.md, "Deploy").

[Unit]
Description=DNS Security Auditor - FastAPI (Full)
After=network.target

[Service]
Type=simple
User=DEPLOY_USER
WorkingDirectory=/home/DEPLOY_USER/dns-security-auditor
Environment="PATH=/home/DEPLOY_USER/.venv/bin"
# SINGLE WORKER BY DESIGN. Do not add --workers. Do not set WEB_CONCURRENCY.
# server.py keeps its coordination state in module-level globals, private to
# one process: _rate_limits, _active_audits, _inflight, _cache and
# _health_cache. The reasoning is in CLAUDE.md, "Single worker by design".
#
# --host 127.0.0.1 is also deliberate: nginx terminates TLS in front of this
# and proxies to loopback, so the app must never accept connections directly.
# --proxy-headers --forwarded-allow-ips 127.0.0.1 are uvicorn's defaults,
# named so an environment variable cannot widen them. Only nginx on loopback
# is trusted; see _get_client_ip in server.py.
# --no-access-log: uvicorn's access log prints the client address of every
# request to stdout, which journald and syslog keep on disk. The privacy page
# says the application writes the IP to no file.
ExecStart=/home/DEPLOY_USER/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=always
RestartSec=3
LimitNOFILE=65535
# TasksMax caps the threads this unit may run. It must exceed
# AUDIT_THREAD_CEILING in audit_engine.py (the most threads the three audit
# pools can hold, and they never shrink) plus about 100 for uvicorn, anyio,
# the per-audit stream thread in server.py and sentry. Left unset, systemd's
# default is 15 percent of kernel threads-max, which on this droplet sat
# below the pools' ceiling: every audit failed with "can't start new thread"
# until a restart. server.py logs a warning at startup when the limit is
# too low, and /api/health reports threads and thread_ceiling.
TasksMax=4096

# Hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/DEPLOY_USER/dns-security-auditor
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
